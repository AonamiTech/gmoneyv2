GMONEY_ENV=development
GMONEY_TENANT_ID=development
GMONEY_DATABASE_URL=postgresql+asyncpg://gmoney:gmoney@postgres:5432/gmoney
GMONEY_TEMPORAL_TARGET=temporal:7233
GMONEY_S3_ENDPOINT=http://minio:9000
GMONEY_S3_ACCESS_KEY=gmoney
GMONEY_S3_SECRET_KEY=change-me
GMONEY_S3_BUCKET=gmoney-v2
GMONEY_LEGACY_ROOT=/home/azureuser/gmoney
GMONEY_PROFILE_ROOT=/home/azureuser/gmoneyv2-runtime/profiles
# Build arguments baked into image labels and /etc/gmoney/release.json.
GMONEY_BUILD_REVISION=
GMONEY_REQUIRE_BUILD_REVISION=0
GEMINI_API_KEY=
GMONEY_GEMINI_MODEL=gemini-3.5-flash
GMONEY_GEMINI_TIMEOUT_SECONDS=120
GMONEY_GEMINI_MAX_CALLS_PER_DOCUMENT=4
GMONEY_GEMINI_MAX_COST_USD_PER_DOCUMENT=0.25
GMONEY_GEMINI_INPUT_COST_USD_PER_MILLION=0
GMONEY_GEMINI_OUTPUT_COST_USD_PER_MILLION=0
GMONEY_GEMINI_PROMPT_VERSION=phase3-grounded-v1
GMONEY_GEMINI_REDACTION_VERSION=phase3-redaction-v1
# Required only with --gemini-mode enabled; challenger mode needs no promotion file.
GMONEY_GEMINI_PROMOTION_PATH=
